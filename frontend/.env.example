# Vite exposes every VITE_* variable to the browser bundle. Only put values
# here that are safe to ship to a client — never the Supabase service role key.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=your-supabase-project-url

# The ANON (public) key — not the service role key. RLS is what keeps it safe.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Where the FastAPI backend is reachable. Defaults to http://127.0.0.1:8000
# in lib/api.ts if unset; set it explicitly for any deployed build.
VITE_API_BASE_URL=http://127.0.0.1:8000
